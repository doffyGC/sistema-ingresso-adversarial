%% Fig. 4 - Superficie de ataque (secao 3.4, docs/superficie-ataque.md). Fonte editavel; exportado para superficie-de-ataque.svg e .png
%% Cores seguem a legenda da secao 3.1: verde A1, vermelho A2, azul componentes da plataforma (A3), amarelo ativo.
%% Laranja: ponto de exploracao (PE1 a PE8). Contorno grosso: ponto criado por resposta de A3 nas rodadas 1 e 2.
%% Linha continua preta: requisicao ou transicao de estado. Pontilhada preta: resposta de F7 que volta como sinal. Pontilhada laranja: onde o ponto se localiza.
flowchart TB
    A1["<b>A1</b><br/>comprador legítimo<br/>manual, poucas tentativas"]
    A2["<b>A2</b><br/>comprador adversarial<br/>automação, proxies, muitas contas"]

    subgraph BORDA["Borda da API: fronteira de confiança"]
        direction LR
        rl["<b>Controle de ritmo</b><br/>30 req/min por IP e sessão (rodada 1)"]
        F1["<b>F1</b> Consulta de disponibilidade"]
        F2["<b>F2</b> Criação de reserva<br/>+ CAPTCHA (rodada 2)"]
        F4["<b>F4</b> Confirmação de pagamento"]
        F5["<b>F5</b> Cadastro e autenticação"]
        F6["<b>F6</b> Fila de espera"]
        F7["<b>F7</b> Mensagens e códigos de resposta"]
        PE6>"<b>PE6</b> limiar fixo por IP e sessão<br/>criado na rodada 1"]
        PE7>"<b>PE7</b> mensagem como oráculo<br/>criado na rodada 1"]
    end

    subgraph PLAT["Interior da plataforma (A3)"]
        direction LR
        disp["<b>Disponibilidade</b><br/>cache e réplicas"]
        res["<b>Reserva</b><br/>limite de 4 por conta, TTL 10 min<br/>lê o limite, depois grava"]
        ident["<b>Identidade</b><br/>conta = e-mail + CPF declarado"]
        fila["<b>Fila de espera</b><br/>uma posição sorteada por conta"]
        pag["<b>Pagamento</b>"]
        exp["<b>Expiração (F3)</b><br/>TTL vence e o ingresso volta<br/>à disponibilidade pública"]
        estoque[("<b>Estoque</b><br/>ativo a preservar")]
        PE1>"<b>PE1</b> leitura gratuita<br/>e visões divergentes"]
        PE2>"<b>PE2</b> reserva retém<br/>estoque sem custo"]
        PE3>"<b>PE3</b> devolução previsível<br/>e pública"]
        PE4>"<b>PE4</b> limite por conta,<br/>conta barata"]
        PE5>"<b>PE5</b> limite sob<br/>requisições simultâneas"]
        PE8>"<b>PE8</b> cada conta é um bilhete<br/>criado na rodada 2"]
    end

    A1 --> rl
    A2 --> rl
    rl --> F1
    rl --> F2
    rl --> F4
    rl --> F5
    rl --> F6
    F1 --> disp
    F2 --> res
    F4 --> pag
    F5 --> ident
    F6 --> fila
    disp --> estoque
    res --> ident
    fila --> res
    res --> estoque
    pag --> estoque
    res --> exp
    exp -- "devolve" --> estoque
    A1 <-.- F7
    A2 <-.- F7

    PE1 -.- disp
    PE2 -.- res
    PE3 -.- exp
    PE4 -.- ident
    PE5 -.- res
    PE6 -.- rl
    PE7 -.- F7
    PE8 -.- fila

    classDef leg fill:#e3f4e1,stroke:#2e7d32,color:#000
    classDef adv fill:#fde2e2,stroke:#c62828,color:#000
    classDef def fill:#e3edfb,stroke:#1f5fbf,color:#000
    classDef ativo fill:#fff4c2,stroke:#b8860b,color:#000
    classDef pe fill:#ffe0b2,stroke:#e65100,color:#000
    classDef pedef fill:#ffe0b2,stroke:#e65100,stroke-width:3px,color:#000
    class A1 leg
    class A2 adv
    class rl,F1,F2,F4,F5,F6,F7,disp,res,ident,fila,pag,exp def
    class estoque ativo
    class PE1,PE2,PE3,PE4,PE5 pe
    class PE6,PE7,PE8 pedef
    style BORDA fill:#f7f9fc,stroke:#1f5fbf,stroke-dasharray:6 4
    style PLAT fill:#ffffff,stroke:#1f5fbf

    linkStyle 21,22,23,24,25,26,27,28 stroke:#e65100,stroke-width:2px,stroke-dasharray:3 3
